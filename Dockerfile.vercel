FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NEUROLAB_EXPERIMENT_DB=/tmp/neurolab/experiments.sqlite3

WORKDIR /app

COPY requirements-vercel.txt ./requirements-vercel.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-vercel.txt

COPY app.py ./app.py
COPY src ./src
COPY .streamlit ./.streamlit

CMD ["sh", "-c", "exec streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-80} --server.headless=true --browser.gatherUsageStats=false"]
